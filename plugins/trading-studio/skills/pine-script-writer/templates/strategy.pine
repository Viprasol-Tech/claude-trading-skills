//@version=6
// Part of claude-trading-skills by Viprasol Tech Private Limited.
// Strategy template with realistic costs, ATR stops and risk-based sizing.
// Educational only - check the results with the backtest-auditor skill.
strategy("Risk-Sized Strategy Template", shorttitle = "RSST", overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 2, pyramiding = 0,
     margin_long = 100, margin_short = 100,
     process_orders_on_close = false, calc_on_every_tick = false)

// ---------- inputs ----------
int   fastLen    = input.int(20, "Fast EMA", minval = 1, group = "Signal")
int   slowLen    = input.int(50, "Slow EMA", minval = 2, group = "Signal")
float riskPct    = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 10, step = 0.1, group = "Risk")
int   atrLen     = input.int(14, "ATR length", minval = 1, group = "Risk")
float atrMult    = input.float(2.0, "Stop = ATR x", minval = 0.1, step = 0.1, group = "Risk")
float rr         = input.float(2.0, "Target = stop x (0 = none)", minval = 0, step = 0.1, group = "Risk")
float qtyStep    = input.float(1.0, "Quantity step (1 = whole shares, 0.001 = BTC)", minval = 0.00000001, group = "Risk")
bool  allowShort = input.bool(true, "Allow shorts", group = "Risk")
int   startYear  = input.int(2018, "Backtest from year", minval = 1970, group = "Window")

// ---------- signals: history functions in global scope, every bar ----------
float fast      = ta.ema(close, fastLen)
float slow      = ta.ema(close, slowLen)
float atr       = ta.atr(atrLen)
bool  crossUp   = ta.crossover(fast, slow)
bool  crossDown = ta.crossunder(fast, slow)
bool  inWindow  = year(time) >= startYear
bool  longCond  = inWindow and crossUp
bool  shortCond = inWindow and allowShort and crossDown

// Quantity so that hitting the stop loses riskPct of current equity, rounded DOWN.
qtyForRisk(float stopDist) =>
    float riskMoney = strategy.equity * riskPct / 100
    float perUnit   = stopDist * syminfo.pointvalue
    perUnit > 0 ? math.floor(riskMoney / perUnit / qtyStep) * qtyStep : 0.0

// Stop distance is fixed when the order is placed, not recalculated every bar.
var float tradeStopDist = na

// The exit is sent together with the entry, so the stop is live on the fill bar.
// Its first levels are estimated from this close; once filled, they are re-anchored
// to the actual fill price below.
if longCond and strategy.position_size <= 0
    float d = atr * atrMult
    float q = qtyForRisk(d)
    if q > 0
        tradeStopDist := d
        strategy.entry("Long", strategy.long, qty = q)
        strategy.exit("Long exit", "Long", stop = close - d, limit = rr > 0 ? close + d * rr : na)

if shortCond and strategy.position_size >= 0
    float d = atr * atrMult
    float q = qtyForRisk(d)
    if q > 0
        tradeStopDist := d
        strategy.entry("Short", strategy.short, qty = q)
        strategy.exit("Short exit", "Short", stop = close + d, limit = rr > 0 ? close - d * rr : na)

if strategy.position_size > 0 and not na(tradeStopDist)
    float sl = strategy.position_avg_price - tradeStopDist
    float tp = rr > 0 ? strategy.position_avg_price + tradeStopDist * rr : na
    strategy.exit("Long exit", "Long", stop = sl, limit = tp)
if strategy.position_size < 0 and not na(tradeStopDist)
    float sl = strategy.position_avg_price + tradeStopDist
    float tp = rr > 0 ? strategy.position_avg_price - tradeStopDist * rr : na
    strategy.exit("Short exit", "Short", stop = sl, limit = tp)

plot(fast, "Fast EMA", color.teal)
plot(slow, "Slow EMA", color.orange)
